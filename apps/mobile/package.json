  "devDependencies": {
    "@hot-updater/cloudflare": "1.1.8",
    "@hot-updater/expo": "1.1.8",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-preset-expo": "~58.0.20",
    "hot-updater": "1.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^expo-apple-authentication$": "<rootDir>/src/test/appleAuthMock.tsx",
      "^@shopify/react-native-skia$": "<rootDir>/src/test/skiaMock.tsx",
      "^@hot-updater/react-native$": "<rootDir>/src/test/hotUpdaterMock.tsx",
      "^(?:\\.\\./)+assets/catalog/images/([a-z_]+)\\.png$": "<rootDir>/../../assets/catalog/images/$1@2x.png",
      "^(?:\\.\\./)+assets/loader/([a-z_]+)\\.png$": "<rootDir>/assets/loader/$1@2x.png",
      "^react-native-reanimated$": "<rootDir>/src/test/reanimatedMock.tsx"
    }
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-image-manipulator",
          "expo-file-system"
        ]
      }
    }
  }
