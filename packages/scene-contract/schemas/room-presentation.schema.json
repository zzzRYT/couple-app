{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://couple-app.invalid/contracts/room-presentation-v1.schema.json",
  "title": "Room Presentation v1",
  "description": "Native D-day widget presentation; date value and accessibility semantics are app-owned and omitted from this AI-editable document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "visible", "x", "y", "width", "height", "styleToken", "textScale"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "visible": { "type": "boolean" },
    "x": { "type": "number", "minimum": 0, "maximum": 1 },
    "y": { "type": "number", "minimum": 0, "maximum": 1 },
    "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "styleToken": { "type": "string", "enum": ["day.default", "day.card", "day.minimal", "day.accent", "night.default", "night.card", "night.minimal", "night.accent"] },
    "textScale": { "type": "number", "minimum": 1, "maximum": 1.5 },
    "surfaceToken": { "type": "string", "enum": ["surface.paper", "surface.soft", "surface.accent", "surface.night", "surface.nightSoft", "surface.nightAccent"] }
  }
}
