  "typography": {
    "families": {
      "ko": {
        "display": [
          "Gaegu 700",
          "Gowun Dodum 400",
          "Noto Sans KR 400"
        ],
        "body": [
          "Gowun Dodum 400",
          "Noto Sans KR 400"
        ],
        "emphasis": [
          "Noto Sans KR 500/700",
          "Gowun Dodum 400"
        ]
      },
      "en": {
        "display": [
          "Gaegu 700",
          "Gowun Dodum 400"
        ],
        "body": [
          "Gowun Dodum 400",
          "Noto Sans KR 400"
        ],
        "emphasis": [
          "Noto Sans KR 500/700"
        ]
      },
      "ja": {
        "display": [
          "Yomogi 400",
          "Zen Maru Gothic 400",
          "Noto Sans JP 400"
        ],
        "body": [
          "Zen Maru Gothic 400",
          "Noto Sans JP 400"
        ],
        "emphasis": [
          "Zen Maru Gothic 500/700",
          "Noto Sans JP 500/700"
        ]
      }
    },
    "faceRule": "display only when the token size at 100% is >= 20px AND the weight is semibold/bold (titles, big D-day number, mascot speech, room text). Everything smaller uses body or emphasis. The rule is evaluated on the token, never on the scaled size.",
    "scale": {
      "display": {
        "size": 56,
        "weight": 700,
        "face": "display"
      },
      "title": {
        "size": 28,
        "weight": 700,
        "face": "display"
      },
      "heading": {
        "size": 20,
        "weight": 700,
        "face": "display"
      },
      "body": {
        "size": 16,
        "weight": 400,
        "face": "body"
      },
      "label": {
        "size": 16,
        "weight": 600,
        "face": "emphasis"
      },
      "bodySm": {
        "size": 14,
        "weight": 400,
        "face": "body"
      },
      "caption": {
        "size": 12,
        "weight": 400,
        "face": "body"
      }
    },
    "lineHeight": {
      "ko": 1.5,
      "en": 1.4,
      "ja": 1.6,
      "display": 1.1
    },
    "wordBreak": {
      "ko": "keep-all",
      "en": "normal",
      "ja": "normal (line-break: strict)"
    },
    "fontScale": {
      "designedUpTo": 2,
      "toolbarLabelCap": 1.6,
      "note": "iOS Dynamic Type beyond 200% falls back to the 200% layout with scrolling; system tab bar sizing is owned by the OS"
    },
