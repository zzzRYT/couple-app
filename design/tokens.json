  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "radius": {
    "input": 16,
    "card": 20,
    "sheet": 28,
    "pill": 999,
    "cornerJitter": "each corner radius varies by about +-12% (hand-drawn), not applied to system components"
  },
  "border": {
    "outline": {
      "normal": 2,
      "highContrast": 3
    },
    "unit": "px",
    "colorToken": "app.*.line"
  },
  "touch": {
    "minimum": 48,
    "platformMinimum": {
      "ios": 44,
      "android": 48
    },
    "toolbarHeight": 52
  },
  "safeArea": {
    "ios": {
      "top": 47,
      "bottom": 34
    },
    "android": {
      "top": 32,
      "bottomGesture": 24,
      "bottomThreeButton": 48
    },
    "note": "real values are measured on device; the protected zones are computed from them"
  },
  "elevation": "none (flat; no shadows anywhere, including controls and dialogs)",
  "motion": {
    "transitionMs": 150,
    "reducedMotion": "no transition"
  },
  "focus": {
    "ringWidth": 3,
    "offset": 3,
    "minContrast": 3
  },
  "layout": {
    "floorLineRatio": 0.68,
    "roomObjectsMax": 16,
    "roomTextsMax": 3,
    "sceneTextMinSizePt": 20,
    "protectedZones": [
      "system safe area (top/bottom)",
      "room toolbar (top)",
      "D-day widget",
      "system tab bar (bottom)"
    ],
    "toolbarLabelCap": 1.6
  },
  "contrast": {
    "pairsChecked": 424,
    "failures": 0,
    "matrix": "room(day|night) x app(light|dark) x (normal|high contrast)",
    "minText": 4.5,
    "minNonText": 3
  }
}
