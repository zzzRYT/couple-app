{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://couple-app.invalid/contracts/room-scene-v1.schema.json",
  "title": "Couple Room Scene v1",
  "description": "Serializable catalog decoration data rendered by the fixed application. Each room has exactly one app-owned mascot. D-day and app controls are native views outside this canvas document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canvasProfile", "objects", "texts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "canvasProfile": { "const": "room-portrait-v1" },
    "objects": {
      "type": "array",
      "maxItems": 16,
      "contains": { "type": "object", "properties": { "assetId": { "const": "app_mascot" } }, "required": ["assetId"] },
      "maxContains": 1,
      "items": { "$ref": "#/$defs/object" }
    },
    "texts": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "unitCoordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "unitSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "x", "y", "width", "height", "rotationDeg", "zIndex", "opacity"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "x": { "$ref": "#/$defs/unitCoordinate" },
        "y": { "$ref": "#/$defs/unitCoordinate" },
        "width": { "$ref": "#/$defs/unitSize" },
        "height": { "$ref": "#/$defs/unitSize" },
        "rotationDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "zIndex": { "type": "integer", "minimum": 0, "maximum": 31 },
        "opacity": { "type": "number", "minimum": 0.2, "maximum": 1 },
        "mascotState": { "$ref": "#/$defs/mascotState" }
      },
      "allOf": [
        {
          "if": { "properties": { "assetId": { "const": "app_mascot" } }, "required": ["assetId"] },
          "then": { "required": ["mascotState"] },
          "else": { "not": { "required": ["mascotState"] } }
        }
      ]
    },
    "mascotState": {
      "description": "State for the fixed app-owned mascot base asset. Catalog validation binds each wearable ID to its declared slot.",
      "type": "object",
      "additionalProperties": false,
      "required": ["colorToken", "expression", "pose"],
      "properties": {
        "colorToken": { "type": "string", "enum": ["mascot.color.cream", "mascot.color.rose", "mascot.color.sky", "mascot.color.mint"] },
        "expression": { "type": "string", "enum": ["mascot.expression.calm", "mascot.expression.happy", "mascot.expression.sleepy"] },
        "pose": { "type": "string", "enum": ["mascot.pose.idle", "mascot.pose.wave", "mascot.pose.sit", "mascot.pose.sleep"] },
        "wearables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "head": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
            "face": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
            "neck": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
            "hand": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "x", "y", "width", "height", "rotationDeg", "zIndex", "styleToken"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "x": { "$ref": "#/$defs/unitCoordinate" },
        "y": { "$ref": "#/$defs/unitCoordinate" },
        "width": { "$ref": "#/$defs/unitSize" },
        "height": { "$ref": "#/$defs/unitSize" },
        "rotationDeg": { "type": "number", "minimum": -15, "maximum": 15 },
        "zIndex": { "type": "integer", "minimum": 0, "maximum": 31 },
        "styleToken": { "type": "string", "enum": ["text.primary", "text.accent", "text.soft"] }
      }
    }
  }
}
